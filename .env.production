# ============================================================
# RTCrackers - Production Environment
# Supabase PostgreSQL + Render
# ============================================================

# -----------------------------
# APPLICATION
# -----------------------------
ENVIRONMENT=production
DEBUG=false
APP_VERSION=1.0.0

STORE_NAME=RTCrackers
STORE_ADDRESS=Sivakasi, Tamil Nadu, India
STORE_STATE=Tamil Nadu
STORE_EMAIL=support@rtcrackers.com
ORDER_ADMIN_EMAILS=support@rtcrackers.com
STORE_PHONE=
STORE_GSTIN=
DEFAULT_MIN_ORDER_AMOUNT=500


# ============================================================
# FRONTEND / CORS
# ============================================================

# Temporary until Render TLS for the custom domain is valid.
FRONTEND_URL=https://YOUR-FRONTEND.onrender.com
CORS_ORIGINS=https://YOUR-FRONTEND.onrender.com
AUTH_COOKIE_DOMAIN=

AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax


# ============================================================
# SUPABASE POSTGRESQL
# ============================================================

# Supabase Session Pooler connection string.
DATABASE_URL=YOUR_SUPABASE_POOLER_CONNECTION_STRING

# Supabase direct connection string for migrations.
MIGRATION_DATABASE_URL=YOUR_SUPABASE_DIRECT_CONNECTION_STRING

DB_SSL_MODE=require
DB_SSL_CA_FILE=
DB_PGBOUNCER=true

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=15
DB_COMMAND_TIMEOUT=60


# ============================================================
# JWT / AUTHENTICATION
# ============================================================

# Generate a NEW secret. Do not reuse the one previously pasted.
JWT_SECRET_KEY=YOUR_NEW_JWT_SECRET

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_RESET_EXPIRE_MINUTES=30


# ============================================================
# REDIS / CELERY
# ============================================================

REDIS_URL=redis://red-db0svns9v7es73ct4pug:6379/0
CELERY_BROKER_URL=redis://red-db0svns9v7es73ct4pug:6379/1
CELERY_RESULT_BACKEND=redis://red-db0svns9v7es73ct4pug:6379/2


# ============================================================
# EMAIL / RESEND
# ============================================================

EMAIL_BACKEND=resend

# Generate a NEW Resend API key.
RESEND_API_KEY=YOUR_NEW_RESEND_API_KEY

RESEND_FROM_NAME=RTCrackers
EMAIL_FROM=RTCrackers <no-reply@rtcrackers.com>
EMAIL_WEBHOOK_SECRET=


# ============================================================
# SMTP
# ============================================================

SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=
SMTP_START_TLS=


# ============================================================
# SMS
# ============================================================

SMS_BACKEND=console


# ============================================================
# MEDIA / FILE STORAGE
# ============================================================

STORAGE_BACKEND=local
LOCAL_MEDIA_DIR=media
LOCAL_STORAGE_DIR=media
MAX_UPLOAD_MB=5


# ============================================================
# RATE LIMITING
# ============================================================

RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=240
RATE_LIMIT_AUTH_PER_MINUTE=20


# ============================================================
# PAYMENT
# ============================================================

PAYMENT_METHOD=cod


# ============================================================
# ADMIN
# ============================================================

APP_NAME=RTCrackers
ADMIN_FRONTEND_RESET_URL=https://YOUR-FRONTEND.onrender.com/admin/reset-password