# RTCrackers production/local environment template. Never commit real secrets.
ENVIRONMENT=production
DEBUG=false
APP_VERSION=1.0.0
FRONTEND_URL=https://www.rtcrackers.com
CORS_ORIGINS=https://www.rtcrackers.com
AUTH_COOKIE_DOMAIN=.rtcrackers.com
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax

# PostgreSQL: use your managed PostgreSQL URL in production.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/rtcrackers
MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@DIRECT_HOST:5432/rtcrackers
DB_SSL_MODE=verify-full
DB_SSL_CA_FILE=
DB_PGBOUNCER=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=15
DB_COMMAND_TIMEOUT=60

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_48_PLUS_CHARACTER_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Email/SMS (console is safe for local development only)
EMAIL_BACKEND=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_START_TLS=true
EMAIL_FROM=RTCrackers <no-reply@rtcrackers.com>
SMS_BACKEND=console

# Store
STORE_NAME=RTCrackers
STORE_ADDRESS=Sivakasi, Tamil Nadu, India
STORE_STATE=Tamil Nadu
STORE_EMAIL=support@rtcrackers.com
ORDER_ADMIN_EMAILS=support@rtcrackers.com
STORE_PHONE=
STORE_GSTIN=
DEFAULT_MIN_ORDER_AMOUNT=500

# Media
STORAGE_BACKEND=local
LOCAL_MEDIA_DIR=media
MAX_UPLOAD_MB=5

# Rate limits
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=240
RATE_LIMIT_AUTH_PER_MINUTE=20
