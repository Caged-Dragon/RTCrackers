APP_NAME=RTCrackers API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
FRONTEND_URL=https://www.rtcrackers.com
CORS_ORIGINS=https://www.rtcrackers.com
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_PROJECT.supabase.co:5432/postgres
MIGRATION_DATABASE_URL=
DB_SSL_MODE=verify-full
DB_PGBOUNCER=false
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
STORAGE_BACKEND=local
LOCAL_MEDIA_DIR=media
EMAIL_BACKEND=console
SMS_BACKEND=console
RATE_LIMIT_ENABLED=true

# Auth cookies: set domain to .rtcrackers.com when frontend and APIs use subdomains.
AUTH_COOKIE_DOMAIN=.rtcrackers.com
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax

# Supabase-backed shared combo catalogue. Publishable key is safe for public reads;
# SERVICE_ROLE_KEY is server-only and must never be placed in frontend files.
SUPABASE_URL=https://ypmiinmkyvzdpakbkers.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_5qcy4L4sPBxHqRdvk_A1kw_tPJPXxhm
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=combo-pack-images
MAX_UPLOAD_MB=5
