DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/rtcrackers
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
EMAIL_BACKEND=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=no-reply@rtcrackers.com
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=media
CORS_ORIGINS=https://www.rtcrackers.com
ENVIRONMENT=development
DEBUG=false

# Auth cookies: set domain to .rtcrackers.com when frontend and APIs use subdomains.
AUTH_COOKIE_DOMAIN=.rtcrackers.com
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax

RESEND_API_KEY=
RESEND_FROM_NAME=RTC Crackers
EMAIL_WEBHOOK_SECRET=

# Supabase-backed shared combo catalogue. Publishable key is safe for public reads;
# SERVICE_ROLE_KEY is server-only and must never be placed in frontend files.
SUPABASE_URL=https://ypmiinmkyvzdpakbkers.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_5qcy4L4sPBxHqRdvk_A1kw_tPJPXxhm
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=combo-pack-images
MAX_UPLOAD_MB=5
RESEND_WEBHOOK_SECRET=
