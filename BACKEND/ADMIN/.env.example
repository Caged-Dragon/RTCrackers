APP_NAME=RTCrackers Admin API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=https://www.rtcrackers.com
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_PROJECT.supabase.co:5432/postgres
MIGRATION_DATABASE_URL=
DB_SSL_MODE=verify-full
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_RESET_EXPIRE_MINUTES=30
RATE_LIMIT_ENABLED=true
ADMIN_FRONTEND_RESET_URL=https://www.rtcrackers.com/admin/reset-password
EMAIL_BACKEND=console
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_START_TLS=true
EMAIL_FROM=RTCrackers <no-reply@rtcrackers.com>

# Auth cookies: set domain to .rtcrackers.com when frontend and APIs use subdomains.
AUTH_COOKIE_DOMAIN=.rtcrackers.com
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
